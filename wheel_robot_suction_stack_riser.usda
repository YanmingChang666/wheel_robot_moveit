#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./wheel_robot_suction_stack.usd@
    ]
    upAxis = "Z"
)

def Cube "PalletRiser" (
    prepend apiSchemas = ["PhysicsCollisionAPI"]
)
{
    float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
    bool physics:collisionEnabled = 1
    color3f[] primvars:displayColor = [(0.62, 0.47, 0.3)]
    double size = 1
    float3 xformOp:scale = (1.2, 1, 0.08)
    double3 xformOp:translate = (0.0015, 1.1214, 0.165)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

over "Render" (
    hide_in_stage_window = true
)
{
}

over "ActionGraph"
{
    def OmniGraphNode "suction_holding_pub_right"
    {
        custom uint64 inputs:context
        prepend uint64 inputs:context.connect = </ActionGraph/ros2_context.outputs:context>
        custom bool inputs:data
        custom uint inputs:execIn (
            customData = {
                bool isExecution = 1
            }
        )
        prepend uint inputs:execIn.connect = </ActionGraph/on_playback_tick.outputs:tick>
        custom string inputs:messageName = "Bool"
        custom string inputs:messagePackage = "std_msgs"
        custom string inputs:messageSubfolder = "msg"
        custom string inputs:nodeNamespace
        custom string inputs:qosProfile
        custom uint64 inputs:queueSize
        custom string inputs:topicName = "right_suction_holding"
        token node:type = "isaacsim.ros2.bridge.ROS2Publisher"
        int node:typeVersion = 1
        custom uint outputs:execOut (
            customData = {
                bool isExecution = 1
            }
        )
    }

    over "suction_command"
    {
        custom string inputs:script = '''import omni.graph.core as og
import omni.usd

PREVIOUS = {}

ARMS = (
    ("left", "/ActionGraph/suction_left_sub", "/wheel_robot/tool0_L/suction_cup",
     "/ActionGraph/suction_left_close", "/ActionGraph/suction_left_open"),
    ("right", "/ActionGraph/suction_right_sub", "/wheel_robot/tool0_R/suction_cup",
     "/ActionGraph/suction_right_close", "/ActionGraph/suction_right_open"),
)


def _pulse(path):
    node = og.Controller.node(path)
    if not node.is_valid():
        return
    impulse = node.get_attribute("state:enableImpulse")
    if impulse.is_valid():
        impulse.set(True)
    node.request_compute()


def _ros_closed(node_path):
    node = og.Controller.node(node_path)
    if not node.is_valid():
        return None
    data = node.get_attribute("outputs:data")
    if not data.is_valid():
        return None
    return bool(data.get())


def _prim_closed(prim_path):
    stage = omni.usd.get_context().get_stage()
    prim = stage.GetPrimAtPath(prim_path)
    if not prim.IsValid():
        return None
    attr = prim.GetAttribute("suctionClosed")
    if not attr.IsValid() or not attr.HasAuthoredValue():
        return None
    return bool(attr.Get())


def _on_change(key, value, close_path, open_path):
    if value is None:
        return
    seen = key in PREVIOUS
    last = PREVIOUS.get(key)
    PREVIOUS[key] = value
    if not seen or last == value:
        return
    _pulse(close_path if value else open_path)


# onStep must come from an OnImpulseEvent. When a grip lets go, the
# SurfaceGripper writes state:enableImpulse on whatever feeds onStep.
# on_playback_tick has no such attribute, so the second grip aborts.
STEP = (
    "/ActionGraph/suction_left_step",
    "/ActionGraph/suction_right_step",
)



def _publish_holding():
    pairs = (
        ("/ActionGraph/suction_left", "/ActionGraph/suction_holding_pub"),
        ("/ActionGraph/suction_right", "/ActionGraph/suction_holding_pub_right"),
    )
    for grip_path, pub_path in pairs:
        grip = og.Controller.node(grip_path)
        pub = og.Controller.node(pub_path)
        if not grip.is_valid() or not pub.is_valid():
            continue
        closed = grip.get_attribute("outputs:Closed")
        data = pub.get_attribute("inputs:data")
        if not closed.is_valid() or not data.is_valid():
            continue
        try:
            data.set(bool(closed.get()))
        except Exception:
            continue


def compute(db):
    for path in STEP:
        _pulse(path)
    for key, subscriber, prim_path, close_path, open_path in ARMS:
        _on_change(key + "_ros", _ros_closed(subscriber), close_path, open_path)
        _on_change(key + "_prim", _prim_closed(prim_path), close_path, open_path)
    _publish_holding()
    return True
'''
        custom bool state:omni_initialized = 0
    }

    over "stack_spawner"
    {
        custom string inputs:script = '''from pxr import Gf
import omni.graph.core as og
import omni.usd
from pxr import Gf, UsdGeom, UsdPhysics

PICKUP = (0.5, 0.18, 0.40349999999999997)
SIZE = (0.351, 0.287, 0.105)
READY = 0
# The subscriber keeps the last command after Stop. Treating that leftover
# as a new request spawns box_1 on top of box_0 as soon as Play starts.
BASELINE = None


def _read_spawn():
    node = og.Controller.node("/ActionGraph/stack_spawn_sub")
    if not node.is_valid():
        return None
    data = node.get_attribute("outputs:data")
    if not data.is_valid():
        return None
    return int(data.get())


def _publish_ready():
    node = og.Controller.node("/ActionGraph/stack_ready_pub")
    if not node.is_valid():
        return
    data = node.get_attribute("inputs:data")
    if not data.is_valid():
        return
    try:
        data.set(int(READY))
    except Exception:
        return


def _spawn(index):
    stage = omni.usd.get_context().get_stage()
    path = f"/World/stack/box_{index}"
    if stage.GetPrimAtPath(path).IsValid():
        return
    cube = UsdGeom.Cube.Define(stage, path)
    cube.CreateSizeAttr(1.0)
    cube.AddTranslateOp().Set(Gf.Vec3d(*PICKUP))
    cube.AddScaleOp().Set(Gf.Vec3d(*SIZE))
    cube.CreateDisplayColorAttr([Gf.Vec3f(0.72, 0.55, 0.32)])
    prim = cube.GetPrim()
    UsdPhysics.CollisionAPI.Apply(prim)
    UsdPhysics.RigidBodyAPI.Apply(prim)
    UsdPhysics.MassAPI.Apply(prim).CreateMassAttr(0.4)



def _publish_poses():
    stage = omni.usd.get_context().get_stage()
    pub = og.Controller.node("/ActionGraph/stack_pose_pub")
    if stage is None or not pub.is_valid():
        return
    data = pub.get_attribute("inputs:data")
    if not data.is_valid():
        return
    parts = []
    index = 0
    while index < 40:
        prim = stage.GetPrimAtPath(f"/World/stack/box_{index}")
        if not prim.IsValid():
            break
        matrix = omni.usd.get_world_transform_matrix(prim)
        translation = matrix.ExtractTranslation()
        rotation = Gf.Transform(matrix).GetRotation().GetQuat()
        imaginary = rotation.GetImaginary()
        parts.append(
            f"{index}:{translation[0]:.4f},{translation[1]:.4f},{translation[2]:.4f},"
            f"{imaginary[0]:.5f},{imaginary[1]:.5f},{imaginary[2]:.5f},{rotation.GetReal():.5f}"
        )
        index += 1
    # Negative IDs are actual world-frame gripper query poses, not boxes.
    for key, side in ((-1, "L"), (-2, "R")):
        prim = stage.GetPrimAtPath(f"/wheel_robot/tool0_{side}/suction_cup/grip_point")
        if not prim.IsValid():
            continue
        transform = Gf.Transform(omni.usd.get_world_transform_matrix(prim))
        t = transform.GetTranslation()
        q = transform.GetRotation().GetQuat()
        v = q.GetImaginary()
        parts.append(f"{key}:{t[0]:.5f},{t[1]:.5f},{t[2]:.5f},{v[0]:.6f},{v[1]:.6f},{v[2]:.6f},{q.GetReal():.6f}")
    try:
        data.set(";".join(parts))
    except Exception:
        return


def compute(db):
    global READY, BASELINE
    requested = _read_spawn()
    if BASELINE is None:
        BASELINE = requested
    elif requested is not None and requested != BASELINE:
        if requested > READY:
            _spawn(requested)
            READY = requested
        BASELINE = requested
    _publish_ready()
    _publish_poses()
    return True
'''
    }

    over "suction_left"
    {
        custom float inputs:BendAngle = 45
        custom float inputs:TorqueLimit = 200
    }

    over "suction_right"
    {
        custom float inputs:BendAngle = 45
        custom float inputs:TorqueLimit = 200
    }
}

over "World"
{
    over "stack"
    {
        over "box_0"
        {
            double3 xformOp:translate = (0.5, 0.18, 0.4035)
        }
    }
}

