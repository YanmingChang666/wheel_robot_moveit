<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel_robot">
  <xacro:arg name="initial_positions_file" default="initial_positions.yaml"/>

  <!-- Massless root so robot_state_publisher publishes world -> base_link.
       KDL also rejects a root link that carries inertia. -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <xacro:include filename="$(find robot_description)/urdf/robotiq/robotiq_85_gripper.urdf.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/wheel_robot/wheel_robot_body.urdf.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/wheel_robot/wheel_robot_grippers.urdf.xacro"/>

  <xacro:include filename="wheel_robot.ros2_control.xacro"/>
  <xacro:wheel_robot_ros2_control
    name="IsaacTopicSystem"
    initial_positions_file="$(arg initial_positions_file)"/>
</robot>
